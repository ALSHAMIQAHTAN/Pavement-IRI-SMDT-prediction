# =============================================================================
# Parallel estimation  of IRI and SMTD on RIOHTrack data
# Voting Tree-Ensemble Learning (VTL = RF + ET + HGB), random 70/30 split.
#
# Reproducibility script accompanying the manuscript.
# - Single validation protocol: random 70/30 train/test split (random_state=42).
# - Feature elimination is performed on the TRAINING partition only (no leakage).
# - Figures are DISPLAYED (plt.show); nothing is written to disk.
#
# Usage:
#   Put "Paper_Random_DualTarget_data.xlsx" in the same folder as this script
#   (sheet "ML_Database") and run.  Requires: numpy, pandas, matplotlib,
#   seaborn, scikit-learn, shap, openpyxl.
# =============================================================================

# -----------------------------------------------------------------------------
# 0. Settings LOCAL PATH
#DATA_PATH = r"H:DualTarget_data.xlsx"
# -----------------------------------------------------------------------------
DATA_PATH = "DualTarget_data.xlsx"   # relative path (same folder)
SHEET     = "ML_Database"
TEST_SIZE = 0.30          # 70% train / 30% test
SEED      = 42

# -----------------------------------------------------------------------------
# 1. Imports
# -----------------------------------------------------------------------------
import warnings
warnings.filterwarnings("ignore")

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import shap

from sklearn.ensemble import (RandomForestRegressor, ExtraTreesRegressor,
                              HistGradientBoostingRegressor)
from sklearn.feature_selection import RFECV, VarianceThreshold
from sklearn.model_selection import train_test_split, KFold
from sklearn.metrics import mean_squared_error, r2_score

plt.rcParams.update({
    "font.family": "DejaVu Serif", "font.size": 11,
    "axes.linewidth": 1.2, "axes.labelweight": "bold",
    "axes.titleweight": "bold", "figure.dpi": 120,
})

# -----------------------------------------------------------------------------
# 2. Load data
# -----------------------------------------------------------------------------
print("=" * 70)
print("STEP 1: Load data")
print("=" * 70)
df = pd.read_excel(DATA_PATH, sheet_name=SHEET)
print(f"Loaded {len(df):,} rows x {df.shape[1]} columns")

TARGETS = ["Target_IRI_m_per_km", "Target_SMTD_mm"]
target_labels = {"Target_IRI_m_per_km": "IRI (m/km)",
                 "Target_SMTD_mm": "SMTD (mm)"}

H_COLS = [f"H{i}" for i in range(1, 14)]
E_COLS = [f"E{i}" for i in range(1, 14)]
BASE_PHYS = ["Cycle_Index", "Traffic_Load", "Avg_Air_Temp", "Surface_Temp",
             "Passing_Rate_4.75mm_pct", "Total_AC_Thickness_cm",
             "Total_Structural_cm", "Weighted_Mean_Modulus"]
FEATURES_ALL = BASE_PHYS + H_COLS + E_COLS          # 8 + 13 + 13 = 34 candidates
print(f"Candidate physical features: {len(FEATURES_ALL)}")

df = df.dropna(subset=TARGETS).reset_index(drop=True)
print(f"After dropping records with missing IRI/SMTD: {len(df):,} rows")

n_nan = int(df[FEATURES_ALL].isna().sum().sum())
if n_nan:
    print(f"WARNING: {n_nan} missing feature values -> filled with column median")
    df[FEATURES_ALL] = df[FEATURES_ALL].fillna(df[FEATURES_ALL].median())

Y_all = df[TARGETS].values

# -----------------------------------------------------------------------------
# 3. Random 70/30 split (indices)
# -----------------------------------------------------------------------------
idx_all = np.arange(len(df))
tr, te = train_test_split(idx_all, test_size=TEST_SIZE, random_state=SEED)
print(f"Train: {len(tr):,} rows ({len(tr)/len(df):.0%})   "
      f"Test: {len(te):,} rows ({len(te)/len(df):.0%})")

# -----------------------------------------------------------------------------
# 4. Four-stage feature elimination  (TRAINING ROWS ONLY -> no test leakage)
#    variance -> sparsity -> Spearman correlation -> RFECV (union of 2 targets)
# -----------------------------------------------------------------------------
def select_features(X_tr_df, Y_tr):
    print("\n--- Feature elimination (training rows only) ---")
    cols = list(X_tr_df.columns)

    # A) zero-variance (constant) columns
    vt = VarianceThreshold(0.0).fit(X_tr_df)
    const_cols = [c for c, k in zip(cols, vt.get_support()) if not k]
    print(f"[A] variance  -> drop {len(const_cols)}: {const_cols}")
    after_A = [c for c in cols if c not in const_cols]

    # B) >90% zeros (sparse placeholder layers)
    sparse = [c for c in after_A if (X_tr_df[c] == 0).mean() > 0.90]
    print(f"[B] sparsity  -> drop {len(sparse)}: {sparse}")
    after_B = [c for c in after_A if c not in sparse]

    # C) |Spearman rho| > 0.95 (redundant)
    corr = X_tr_df[after_B].corr(method="spearman").abs()
    upper = corr.where(np.triu(np.ones_like(corr, dtype=bool), k=1))
    redundant = []
    for col in upper.columns:
        if col in redundant:
            continue
        for p in upper[col][upper[col] > 0.95].index:
            if p not in redundant:
                redundant.append(p)
    print(f"[C] |rho|>0.95 -> drop {len(redundant)}: {redundant}")
    after_C = [c for c in after_B if c not in redundant]

    # D) RFECV per target, union of the two selections
    print(f"[D] RFECV per target starting from {len(after_C)} features")
    cv = KFold(n_splits=5, shuffle=True, random_state=SEED)
    Xd = X_tr_df[after_C].values
    sel = {}
    for ti, tn in enumerate(TARGETS):
        est = RandomForestRegressor(n_estimators=200, max_depth=20,
                                    min_samples_leaf=2, random_state=SEED, n_jobs=1)
        s = RFECV(estimator=est, step=1, cv=cv, scoring="r2",
                  min_features_to_select=5, n_jobs=-1)
        s.fit(Xd, Y_tr[:, ti])
        sel[tn] = [f for f, k in zip(after_C, s.support_) if k]
        print(f"    {tn}: kept {len(sel[tn])}")
    union = [c for c in after_C if c in set(sel[TARGETS[0]]) | set(sel[TARGETS[1]])]
    print(f"Union (final retained): {len(union)} features -> {union}")
    return union

UNION = select_features(df.loc[tr, FEATURES_ALL], Y_all[tr])

# -----------------------------------------------------------------------------
# 5. Fit base learners + equal-weight VTL ensemble
# -----------------------------------------------------------------------------
def build_models():
    return {
        "RF":  RandomForestRegressor(n_estimators=800, min_samples_leaf=1,
                                     random_state=SEED, n_jobs=-1),
        "ET":  ExtraTreesRegressor(n_estimators=800, min_samples_leaf=1,
                                   random_state=SEED, n_jobs=-1),
        "HGB": HistGradientBoostingRegressor(max_iter=1500, learning_rate=0.02,
                                             max_depth=10, min_samples_leaf=3,
                                             l2_regularization=0.05,
                                             random_state=SEED),
    }

def train_and_score(Xtr, Xte, ytr, yte):
    models = build_models()
    for m in models.values():
        m.fit(Xtr, ytr)
    base = ["RF", "ET", "HGB"]
    p_tr = {n: models[n].predict(Xtr) for n in base}
    p_te = {n: models[n].predict(Xte) for n in base}
    p_tr["VTL"] = np.mean([p_tr[n] for n in base], axis=0)
    p_te["VTL"] = np.mean([p_te[n] for n in base], axis=0)
    rows = []
    for mn in base + ["VTL"]:
        for dset, y, yh in (("Train", ytr, p_tr[mn]), ("Test", yte, p_te[mn])):
            resid = y - yh
            rel = np.abs(resid / np.maximum(np.abs(y), 1e-9))
            rows.append({
                "model": mn, "set": dset,
                "R2": r2_score(y, yh),
                "RMSE": np.sqrt(np.mean(resid ** 2)),
                "MAE": np.mean(np.abs(resid)),
                "MAPE_pct": np.mean(rel) * 100,
                "Within_15pct": np.mean(rel <= 0.15) * 100,
            })
    return models, p_te, rows

print("\n" + "=" * 70)
print("STEP 2: Fit VTL (RF + ET + HGB) per target - random 70/30")
print("=" * 70)

all_rows, preds = [], {}
rf_models = {}
Xtr, Xte = df.loc[tr, UNION].values, df.loc[te, UNION].values
for ti, tn in enumerate(TARGETS):
    models, p_te, rows = train_and_score(Xtr, Xte, Y_all[tr, ti], Y_all[te, ti])
    for r in rows:
        r["target"] = tn
    all_rows.extend(rows)
    preds[tn] = (Y_all[te, ti], p_te["VTL"])
    rf_models[tn] = models["RF"]

results = pd.DataFrame(all_rows)
test_only = results[results["set"] == "Test"]
print("\nRESULTS SUMMARY (test set, R2):")
print(test_only.pivot_table(index="model", columns="target",
                            values="R2").round(4).to_string())

# -----------------------------------------------------------------------------
# 6. Figures (DISPLAYED only; nothing saved)
# -----------------------------------------------------------------------------
print("\n" + "=" * 70)
print("STEP 3: Display figures")
print("=" * 70)

# Fig 7: correlation heatmap (training rows)
sub = df.loc[tr, UNION + TARGETS].rename(
    columns={"Target_IRI_m_per_km": "IRI", "Target_SMTD_mm": "SMTD"})
fig, ax = plt.subplots(figsize=(11, 9))
sns.heatmap(sub.corr(method="spearman"), cmap="RdBu_r", vmin=-1, vmax=1,
            cbar_kws={"label": "Spearman rho"}, linewidths=0.3,
            linecolor="white", ax=ax)
ax.set_title("Spearman correlation - retained features & targets (train)")
plt.tight_layout(); plt.show()

# Fig 8: model comparison bar (test R2)
fig, axes = plt.subplots(1, 2, figsize=(12, 5.5), sharey=True)
ymin = max(0.0, test_only["R2"].min() - 0.05)
for ax, tn in zip(axes, TARGETS):
    piv = test_only[test_only["target"] == tn].set_index("model")["R2"]
    piv = piv.loc[["RF", "ET", "HGB", "VTL"]]
    piv.plot(kind="bar", ax=ax, color="#4C72B0", edgecolor="black", width=0.7)
    ax.set_ylim(ymin, 1.02); ax.set_ylabel("Test R²")
    ax.set_title(target_labels[tn]); ax.set_xlabel("")
    ax.tick_params(axis="x", rotation=0)
    for i, v in enumerate(piv.values):
        ax.text(i, v + 0.004, f"{v:.3f}", ha="center", fontsize=9, weight="bold")
plt.tight_layout(); plt.show()

# Fig 9: parity plots
fig, axes = plt.subplots(1, 2, figsize=(12, 5.5))
for ax, tn in zip(axes, TARGETS):
    y, yh = preds[tn]
    r2 = r2_score(y, yh); rmse = np.sqrt(mean_squared_error(y, yh))
    ax.scatter(y, yh, color="#4C72B0", alpha=0.6, s=22, edgecolor="black", lw=0.4)
    lo, hi = min(y.min(), yh.min()), max(y.max(), yh.max())
    pad = 0.05 * (hi - lo); xs = np.linspace(lo, hi, 100)
    ax.plot([lo - pad, hi + pad], [lo - pad, hi + pad], color="#C44E52", lw=1.5, label="1:1")
    ax.plot(xs, xs * 1.15, "--", color="grey", lw=0.9, label="±15%")
    ax.plot(xs, xs * 0.85, "--", color="grey", lw=0.9)
    ax.set_xlabel(f"Observed {target_labels[tn]}")
    ax.set_ylabel(f"Predicted {target_labels[tn]}")
    ax.set_title(f"{target_labels[tn]}   $R^2$={r2:.3f}   RMSE={rmse:.3f}")
    ax.grid(True, ls=":", alpha=0.6); ax.legend(frameon=False, fontsize=9, loc="upper left")
plt.tight_layout(); plt.show()

# -----------------------------------------------------------------------------
# 7. SHAP (RF component, held-out test samples)
# -----------------------------------------------------------------------------
print("STEP 4: SHAP on RF (per target)")
X_te = df.loc[te, UNION].values
for tn in TARGETS:
    explainer = shap.TreeExplainer(rf_models[tn])
    n = min(800, X_te.shape[0])
    idx = np.random.RandomState(SEED).choice(X_te.shape[0], size=n, replace=False)
    sv = explainer.shap_values(X_te[idx], check_additivity=False)

    # Fig 10: global SHAP bar
    ser = pd.Series(np.abs(sv).mean(axis=0), index=UNION).sort_values().tail(15)
    plt.figure(figsize=(9, 6))
    plt.barh(ser.index, ser.values, color="#4C72B0", edgecolor="black")
    plt.xlabel("Mean |SHAP|")
    plt.title(f"Global SHAP importance - {target_labels[tn]}")
    plt.grid(True, axis="x", ls=":", alpha=0.6)
    plt.tight_layout(); plt.show()

    # Fig 11: SHAP beeswarm
    plt.figure(figsize=(9, 7))
    shap.summary_plot(sv, X_te[idx], feature_names=UNION, max_display=15, show=False)
    plt.title(f"SHAP beeswarm - {target_labels[tn]}")
    plt.tight_layout(); plt.show()

print("\n" + "=" * 70)
print("HEADLINE RESULTS (VTL, test set)")
print("=" * 70)
for _, row in test_only[test_only["model"] == "VTL"].iterrows():
    print(f"  {row['target'][:20]:20s} | R2 = {row['R2']:.4f} | "
          f"RMSE = {row['RMSE']:.4f} | within +/-15% = {row['Within_15pct']:.1f}%")
