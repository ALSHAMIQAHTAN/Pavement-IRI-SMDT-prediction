# 8. Fig 16: Residual vs observed
# ==============================================================================
fig, axes = plt.subplots(1, 2, figsize=(12, 5))
for ax, t_idx, tn, lbl in zip(axes, [0, 1], TARGETS, ["(a)", "(b)"]):
    y = Yte[:, t_idx]; yh = preds_te["VTL"][:, t_idx]; r = yh - y
    hb = ax.hexbin(y, r, gridsize=25, cmap="Reds", mincnt=1)
    ax.axhline(0, color="black", lw=1)
