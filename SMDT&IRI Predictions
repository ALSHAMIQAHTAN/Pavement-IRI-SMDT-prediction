    ax.set_xlabel(f"Observed {sym(tn)}"); ax.set_ylabel("Residual")
    ax.set_title(f"{lbl} {sym(tn)}")
    plt.colorbar(hb, ax=ax, label="Point density")
    ax.legend(frameon=False, fontsize=8, loc="upper right")
plt.suptitle("Fig. 16  Residual (Predicted - Observed) vs observed - test set", weight="bold")
plt.tight_layout(); plt.savefig(pdf("Fig16_residual_vs_observed")); plt.close()

